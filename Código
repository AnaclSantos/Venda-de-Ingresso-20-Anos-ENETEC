<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ENETEC – Festa de 20 Anos 🎉</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --verde:     #1A7A3E;
    --verde-b:   #2ECC71;
    --verde-neon:#4AFF8C;
    --preto:     #0D0D0D;
    --escuro:    #111811;
    --cinza:     #8A8A8A;
    --branco:    #F5F5F0;
    --cream:     #EDEEE6;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--escuro);
    color: var(--branco);
    font-family: 'DM Sans', sans-serif;
    overflow-x: hidden;
  }

  /* ── NOISE TEXTURE ── */
  body::before {
    content: '';
    position: fixed; inset: 0; z-index: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
    opacity: .4;
  }

  /* ── HERO ── */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 3rem 1.5rem;
    overflow: hidden;
  }

  /* Radial glow */
  .hero::after {
    content: '';
    position: absolute;
    width: 700px; height: 700px;
    background: radial-gradient(circle, rgba(26,122,62,.35) 0%, transparent 70%);
    top: 50%; left: 50%;
    transform: translate(-50%,-50%);
    pointer-events: none;
    animation: pulse 5s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,100% { transform: translate(-50%,-50%) scale(1); opacity:.8; }
    50%      { transform: translate(-50%,-50%) scale(1.15); opacity:1; }
  }

  /* diagonal stripe bg */
  .hero-bg {
    position: absolute; inset: 0; z-index: 0;
    background: repeating-linear-gradient(
      -55deg,
      transparent,
      transparent 40px,
      rgba(26,122,62,.04) 40px,
      rgba(26,122,62,.04) 41px
    );
  }

  .hero-content { position: relative; z-index: 2; }

  .logo-wrap {
    display: flex; align-items: center; justify-content: center;
    gap: 1rem; margin-bottom: 2.5rem;
    animation: fadeDown .8s ease both;
  }

  .logo-wrap img { height: 64px; filter: brightness(0) invert(1); }

  .year-badge {
    background: var(--verde);
    color: var(--branco);
    font-family: 'DM Mono', monospace;
    font-size: .7rem; letter-spacing: .15em;
    padding: .35rem .8rem;
    border-radius: 2px;
    text-transform: uppercase;
    animation: fadeDown .8s .1s ease both;
  }

  .hero-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(5rem, 16vw, 13rem);
    line-height: .9;
    letter-spacing: .02em;
    background: linear-gradient(160deg, var(--branco) 30%, var(--verde-b) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: fadeUp .9s .2s ease both;
  }

  .hero-sub {
    font-size: clamp(.9rem, 2vw, 1.15rem);
    font-weight: 300;
    color: var(--cinza);
    letter-spacing: .08em;
    text-transform: uppercase;
    margin-top: .6rem;
    animation: fadeUp .9s .35s ease both;
  }

  /* Tilo mascot */
  .tilo-wrap {
    position: absolute;
    bottom: -10px; right: calc(5vw);
    width: clamp(160px, 22vw, 280px);
    z-index: 3;
    animation: tiloIn 1.2s .5s cubic-bezier(.34,1.56,.64,1) both;
    filter: drop-shadow(0 20px 40px rgba(46,204,113,.2));
  }

  .tilo-wrap img { width: 100%; }

  @keyframes tiloIn {
    from { transform: translateX(120px) rotate(8deg); opacity: 0; }
    to   { transform: translateX(0) rotate(0); opacity: 1; }
  }

  .tilo-wrap:hover img {
    animation: tiloBounce .6s ease;
  }
  @keyframes tiloBounce {
    0%,100% { transform: translateY(0) rotate(0); }
    30%     { transform: translateY(-18px) rotate(-4deg); }
    60%     { transform: translateY(-6px) rotate(2deg); }
  }

  /* ── INFO CARDS ── */
  .cards-section {
    position: relative; z-index: 2;
    padding: 5rem 1.5rem 4rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .section-label {
    font-family: 'DM Mono', monospace;
    font-size: .7rem; letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--verde-b);
    margin-bottom: 2rem;
    animation: fadeUp .6s ease both;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1px;
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(255,255,255,.06);
    border-radius: 4px;
    overflow: hidden;
  }

  .card {
    background: rgba(255,255,255,.03);
    padding: 2rem 1.5rem;
    display: flex; flex-direction: column;
    gap: .4rem;
    transition: background .3s;
    position: relative;
    overflow: hidden;
  }

  .card::before {
    content: '';
    position: absolute; top: 0; left: 0;
    width: 3px; height: 0;
    background: var(--verde-b);
    transition: height .4s ease;
  }
  .card:hover::before { height: 100%; }
  .card:hover { background: rgba(26,122,62,.12); }

  .card-icon { font-size: 1.6rem; margin-bottom: .2rem; }
  .card-label {
    font-family: 'DM Mono', monospace;
    font-size: .65rem; letter-spacing: .15em;
    text-transform: uppercase;
    color: var(--cinza);
  }
  .card-value {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.8rem; line-height: 1;
    color: var(--branco);
  }
  .card-note {
    font-size: .75rem; color: var(--cinza);
  }

  /* ── LOTE SECTION ── */
  .lote-section {
    position: relative; z-index: 2;
    padding: 2rem 1.5rem 5rem;
    max-width: 1100px; margin: 0 auto;
  }

  .lote-box {
    border: 1px solid rgba(46,204,113,.3);
    border-radius: 4px;
    padding: 2.5rem 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    background: rgba(26,122,62,.07);
    position: relative;
    overflow: hidden;
  }

  .lote-box::after {
    content: '1°';
    position: absolute; right: -1rem; top: -1.5rem;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 8rem;
    color: rgba(46,204,113,.06);
    line-height: 1;
    pointer-events: none;
  }

  .lote-info h3 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2.2rem; color: var(--verde-b);
    line-height: 1;
  }
  .lote-info p { font-size: .85rem; color: var(--cinza); margin-top: .3rem; }

  .lote-price {
    text-align: right;
  }
  .lote-price .price-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 4.5rem; line-height: 1;
    background: linear-gradient(135deg, var(--verde-b), var(--verde-neon));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .lote-price .price-label {
    font-family: 'DM Mono', monospace;
    font-size: .65rem; letter-spacing: .15em;
    color: var(--cinza); text-transform: uppercase;
  }

  /* ── CTA BUTTON ── */
  .cta-wrap {
    display: flex; justify-content: center;
    padding: 0 1.5rem 6rem;
    position: relative; z-index: 2;
  }

  .cta-btn {
    display: inline-flex; align-items: center; gap: .75rem;
    background: var(--verde);
    color: var(--branco);
    font-family: 'DM Sans', sans-serif;
    font-weight: 700; font-size: 1rem;
    letter-spacing: .05em; text-transform: uppercase;
    padding: 1.1rem 2.8rem;
    border-radius: 3px;
    border: none; cursor: pointer;
    text-decoration: none;
    position: relative; overflow: hidden;
    transition: transform .2s, box-shadow .3s;
    box-shadow: 0 0 0 rgba(46,204,113,0);
  }

  .cta-btn::before {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(135deg, var(--verde-b), var(--verde-neon));
    opacity: 0; transition: opacity .3s;
  }
  .cta-btn:hover::before { opacity: 1; }
  .cta-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 40px rgba(46,204,113,.3);
    color: var(--preto);
  }
  .cta-btn span { position: relative; z-index: 1; }
  .cta-btn .arrow { position: relative; z-index: 1; font-size: 1.1rem; transition: transform .3s; }
  .cta-btn:hover .arrow { transform: translateX(4px); }

  /* ── PIX SECTION ── */
  .pix-section {
    position: relative; z-index: 2;
    background: rgba(255,255,255,.02);
    border-top: 1px solid rgba(255,255,255,.06);
    border-bottom: 1px solid rgba(255,255,255,.06);
    padding: 5rem 1.5rem;
  }

  .pix-inner {
    max-width: 800px; margin: 0 auto; text-align: center;
  }

  .pix-inner h2 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1; margin-bottom: 1rem;
  }

  .pix-inner p {
    color: var(--cinza); font-size: .95rem; margin-bottom: 2.5rem;
    line-height: 1.7;
  }

  .pix-key-box {
    display: inline-flex; align-items: center; gap: 1rem;
    background: rgba(26,122,62,.12);
    border: 1px solid rgba(46,204,113,.3);
    border-radius: 4px;
    padding: 1rem 1.5rem;
    cursor: pointer;
    transition: background .3s;
    position: relative;
  }
  .pix-key-box:hover { background: rgba(26,122,62,.2); }

  .pix-key-label {
    font-family: 'DM Mono', monospace;
    font-size: .65rem; letter-spacing: .15em;
    color: var(--cinza); text-transform: uppercase;
    display: block; margin-bottom: .1rem;
  }
  .pix-key-value {
    font-family: 'DM Mono', monospace;
    font-size: 1.1rem;
    color: var(--verde-b);
  }
  .copy-icon { font-size: 1.2rem; color: var(--cinza); transition: color .2s; }
  .pix-key-box:hover .copy-icon { color: var(--verde-b); }

  .copy-toast {
    position: fixed; bottom: 2rem; left: 50%;
    transform: translateX(-50%) translateY(2rem);
    background: var(--verde);
    color: white;
    padding: .7rem 1.5rem;
    border-radius: 3px;
    font-size: .85rem;
    opacity: 0;
    transition: all .4s;
    z-index: 999;
    pointer-events: none;
  }
  .copy-toast.show {
    opacity: 1; transform: translateX(-50%) translateY(0);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-top: 3rem;
    text-align: left;
  }

  .step {
    display: flex; gap: 1rem; align-items: flex-start;
  }

  .step-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2.5rem; line-height: 1;
    color: rgba(46,204,113,.25);
    min-width: 2rem;
  }

  .step-text strong {
    display: block; font-size: .9rem; margin-bottom: .2rem;
  }
  .step-text p { font-size: .8rem; color: var(--cinza); line-height: 1.5; }

  /* ── FOOTER ── */
  footer {
    position: relative; z-index: 2;
    padding: 3rem 1.5rem;
    text-align: center;
    border-top: 1px solid rgba(255,255,255,.05);
  }

  footer img { height: 36px; filter: brightness(0) invert(1); opacity: .4; margin-bottom: 1rem; }
  footer p { font-size: .75rem; color: rgba(255,255,255,.25); letter-spacing: .05em; }

  /* ── ANIMATIONS ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeDown {
    from { opacity: 0; transform: translateY(-16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── SCROLL REVEAL ── */
  .reveal {
    opacity: 0; transform: translateY(30px);
    transition: opacity .7s ease, transform .7s ease;
  }
  .reveal.visible { opacity: 1; transform: translateY(0); }

  /* ── COUNTER ── */
  .counter-wrap {
    display: flex; justify-content: center; gap: 1rem;
    margin-top: 2.5rem; flex-wrap: wrap;
  }
  .counter-unit {
    text-align: center;
    min-width: 70px;
  }
  .counter-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 3.5rem; line-height: 1;
    background: linear-gradient(135deg, var(--branco), var(--verde-b));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .counter-label {
    font-family: 'DM Mono', monospace;
    font-size: .6rem; letter-spacing: .15em;
    text-transform: uppercase; color: var(--cinza);
  }
  .counter-sep {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 3rem; color: rgba(255,255,255,.15);
    align-self: flex-start; padding-top: .2rem;
  }

  @media (max-width: 600px) {
    .tilo-wrap { width: 120px; right: 0; bottom: 0; }
    .hero-title { font-size: 5.5rem; }
    .lote-price .price-num { font-size: 3rem; }
  }
</style>
</head>
<body>

<!-- HERO -->
<section class="hero">
  <div class="hero-bg"></div>

  <div class="hero-content">
    <div class="logo-wrap">
      <img src="data:image/png;base64," alt="ENETEC logo">
      <span class="year-badge">Empresa Júnior · UnB</span>
    </div>

    <h1 class="hero-title">20 ANOS</h1>
    <p class="hero-sub">A maior festa da engenharia elétrica da UnB</p>

    <div class="counter-wrap" id="countdown">
      <div class="counter-unit"><div class="counter-num" id="cd-d">--</div><div class="counter-label">dias</div></div>
      <div class="counter-sep">:</div>
      <div class="counter-unit"><div class="counter-num" id="cd-h">--</div><div class="counter-label">horas</div></div>
      <div class="counter-sep">:</div>
      <div class="counter-unit"><div class="counter-num" id="cd-m">--</div><div class="counter-label">min</div></div>
      <div class="counter-sep">:</div>
      <div class="counter-unit"><div class="counter-num" id="cd-s">--</div><div class="counter-label">seg</div></div>
    </div>
  </div>

  <div class="tilo-wrap" title="Tilo diz: vai ser incrível!">
    <img src="data:image/png;base64," alt="Tilo, mascote da ENETEC">
  </div>
</section>

<!-- INFO CARDS -->
<section class="cards-section">
  <p class="section-label reveal">// detalhes do evento</p>
  <div class="cards-grid reveal">
    <div class="card">
      <span class="card-icon">📅</span>
      <span class="card-label">Data</span>
      <span class="card-value">31 OUT 2026</span>
      <span class="card-note">Sábado</span>
    </div>
    <div class="card">
      <span class="card-icon">🕖</span>
      <span class="card-label">Horário</span>
      <span class="card-value">19:00</span>
      <span class="card-note">Abertura das portas</span>
    </div>
    <div class="card">
      <span class="card-icon">📍</span>
      <span class="card-label">Local</span>
      <span class="card-value">Park Way</span>
      <span class="card-note">Brasília – DF · a confirmar</span>
    </div>
    <div class="card">
      <span class="card-icon">🎟</span>
      <span class="card-label">Ingresso</span>
      <span class="card-value">R$ 80</span>
      <span class="card-note">1º lote · 80 ingressos</span>
    </div>
  </div>
</section>

<!-- LOTE -->
<section class="lote-section">
  <div class="lote-box reveal">
    <div class="lote-info">
      <h3>1° LOTE</h3>
      <p>Garanta já o seu ingresso — vagas limitadas!</p>
      <p style="margin-top:.8rem; font-size:.8rem; color:rgba(255,255,255,.35)">⚡ Apenas 80 ingressos disponíveis</p>
    </div>
    <div class="lote-price">
      <div class="price-label">Valor por pessoa</div>
      <div class="price-num">R$ 80</div>
    </div>
  </div>
</section>

<!-- CTA -->
<div class="cta-wrap">
  <a href="#pix" class="cta-btn">
    <span>Quero meu ingresso</span>
    <span class="arrow">→</span>
  </a>
</div>

<!-- PIX SECTION -->
<section class="pix-section" id="pix">
  <div class="pix-inner">
    <p class="section-label" style="text-align:center; margin-bottom:.5rem">// como comprar</p>
    <h2 class="reveal">COMPRA VIA<br><span style="color:var(--verde-b)">PIX</span></h2>
    <p class="reveal">Faça o pagamento pelo Pix abaixo, depois preencha o formulário de confirmação com seu nome, e-mail e nome do acompanhante. Seu ingresso será enviado em até 24h.</p>

    <div class="pix-key-box reveal" onclick="copyPix()" title="Clique para copiar">
      <div>
        <span class="pix-key-label">Chave Pix</span>
        <span class="pix-key-value" id="pix-key">08.768.283/0001-28</span>
      </div>
      <span class="copy-icon">⧉</span>
    </div>

    <div class="steps reveal">
      <div class="step">
        <span class="step-num">01</span>
        <div class="step-text">
          <strong>Pague o Pix</strong>
          <p>Transfira R$ 80 para a chave ao lado. Guarde o comprovante.</p>
        </div>
      </div>
      <div class="step">
        <span class="step-num">02</span>
        <div class="step-text">
          <strong>Preencha o formulário</strong>
          <p>Informe seu nome, e-mail e nome do acompanhante (se houver).</p>
        </div>
      </div>
      <div class="step">
        <span class="step-num">03</span>
        <div class="step-text">
          <strong>Receba a confirmação</strong>
          <p>Em até 24h você receberá o ingresso no e-mail cadastrado.</p>
        </div>
      </div>
      <div class="step">
        <span class="step-num">04</span>
        <div class="step-text">
          <strong>Apareça e curta</strong>
          <p>20 anos de história pra comemorar. Tilo te espera! 🐊</p>
        </div>
      </div>
    </div>

    <div style="margin-top:2.5rem" class="reveal">
      <a href="https://forms.gle/gGJ2qUi8oDHDttyg7" class="cta-btn" style="margin: 0 auto; display:inline-flex" target="_blank" rel="noopener">
        <span>Formulário de confirmação</span>
        <span class="arrow">→</span>
      </a>
      
    </div>
  </div>
</section>

<!-- FOOTER -->
<footer>
  <img src="data:image/png;base64," alt="ENETEC">
  <p>ENETEC – Empresa Júnior de Engenharia Elétrica · Universidade de Brasília</p>
  <p style="margin-top:.4rem">Festa de 20 Anos · 31/10/2026</p>
</footer>

<div class="copy-toast" id="toast">✓ Chave Pix copiada!</div>

<script>
// ── Countdown ──────────────────────────────────────────────
function updateCountdown() {
  const target = new Date('2026-10-31T19:00:00-03:00');
  const now = new Date();
  const diff = target - now;
  if (diff <= 0) {
    document.getElementById('countdown').innerHTML = '<p style="color:var(--verde-b);font-family:\'Bebas Neue\',sans-serif;font-size:2rem">HOJE É O DIA! 🎉</p>';
    return;
  }
  const d = Math.floor(diff / 86400000);
  const h = Math.floor((diff % 86400000) / 3600000);
  const m = Math.floor((diff % 3600000) / 60000);
  const s = Math.floor((diff % 60000) / 1000);
  document.getElementById('cd-d').textContent = String(d).padStart(2,'0');
  document.getElementById('cd-h').textContent = String(h).padStart(2,'0');
  document.getElementById('cd-m').textContent = String(m).padStart(2,'0');
  document.getElementById('cd-s').textContent = String(s).padStart(2,'0');
}
updateCountdown();
setInterval(updateCountdown, 1000);

// ── Copy Pix ───────────────────────────────────────────────
function copyPix() {
  const key = document.getElementById('pix-key').textContent;
  navigator.clipboard.writeText(key).then(() => {
    const t = document.getElementById('toast');
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 2500);
  });
}

// ── Scroll reveal ──────────────────────────────────────────
const observer = new IntersectionObserver((entries) => {
  entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
}, { threshold: 0.12 });
document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

// ── Tilo hover bounce ─────────────────────────────────────
const tilo = document.querySelector('.tilo-wrap img');
tilo.addEventListener('mouseenter', () => {
  tilo.style.animation = 'none';
  void tilo.offsetWidth;
  tilo.style.animation = 'tiloBounce .6s ease';
});
</script>
</body>
</html>
